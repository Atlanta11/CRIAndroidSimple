<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:overScrollMode="always">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ROBOT CONTROL V3.3  V2008261945"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accessLevelText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPERATOR"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="8dp" />

            <Button
                android:id="@+id/accessButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPERT" />
        </LinearLayout>

        <!-- STATUS -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● DISCONNECTED"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="12dp" />

        <!-- EXPERT CONNECTION -->
        <LinearLayout
            android:id="@+id/expertConnectionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECTION"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ipEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Robot IP"
                        android:inputType="text"
                        android:text="192.168.3.11" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="110dp"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/portEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Port"
                        android:inputType="number"
                        android:text="3920" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CONNECT" />

                <Button
                    android:id="@+id/disconnectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DISCONNECT" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONNECTION INFO"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/connectionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP: -&#10;Port: -&#10;Status: Disconnected"
                android:padding="8dp" />
        </LinearLayout>

        <!-- PROGRAMS -->
        <TextView
            android:id="@+id/programTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROGRAMS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="3"
            android:layout_margin="4dp">

            <Button
                android:id="@+id/programButton1"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:text="P1" />
            <Button
                android:id="@+id/programButton2"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:text="P2" />
            <Button
                android:id="@+id/programButton3"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P3" />
            <Button
                android:id="@+id/programButton4"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P4" />
            <Button
                android:id="@+id/programButton5"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P5" />
            <Button
                android:id="@+id/programButton6"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P6" />
            <Button
                android:id="@+id/programButton7"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P7" />
            <Button
                android:id="@+id/programButton8"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P8" />
            <Button
                android:id="@+id/programButton9"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"

                android:text="P9" />
        </GridLayout>

        <!-- OPERATOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="START"
                android:textSize="16sp" />

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="PAUSE"
                android:textSize="16sp" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="STOP"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- EXISTING EXPERT CONTROLS -->
        <LinearLayout
            android:id="@+id/expertControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <Button
                android:id="@+id/enableButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="ENABLE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="RESET"
                android:textSize="13sp" />

            <Button
                android:id="@+id/out31Button"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="OUT31 OFF"
                android:visibility="gone"
                android:textSize="13sp" />

            <Button
                android:id="@+id/plcButton"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:text="PLC ENABLE"
                android:visibility="gone"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- NEW EXPERT JOG SECTION -->
        <LinearLayout
            android:id="@+id/expertJogLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="JOG / MOTION"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <!-- Motion mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/modeJointButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="JOINT" />

                <Button
                    android:id="@+id/modeCartBaseButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="CART BASE" />

                <Button
                    android:id="@+id/modeCartToolButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="CART TOOL" />

                <Button
                    android:id="@+id/modePlatformButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="PLATFORM" />
            </LinearLayout>

            <!-- X/Y -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/jogXPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A1+" />
                <Button
                    android:id="@+id/jogXMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A1-" />
                <Button
                    android:id="@+id/jogYPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A2+" />
                <Button
                    android:id="@+id/jogYMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A2-" />
            </LinearLayout>

            <!-- Z/A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/jogZPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A3+" />
                <Button
                    android:id="@+id/jogZMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A3-" />
                <Button
                    android:id="@+id/jogAPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A4+" />
                <Button
                    android:id="@+id/jogAMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A4-" />
            </LinearLayout>

            <!-- B/C -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/jogBPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A5+" />
                <Button
                    android:id="@+id/jogBMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A5-" />
                <Button
                    android:id="@+id/jogCPlusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A6+" />
                <Button
                    android:id="@+id/jogCMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="A6-" />
            </LinearLayout>

            <!-- Override + stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/jogOverrideMinusButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="OVERRIDE -" />

                <TextView
                    android:id="@+id/overrideValueText"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Override: 40.0 %"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/jogOverridePlusButton"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:text="OVERRIDE +" />
            </LinearLayout>

            <Button
                android:id="@+id/jogStopButton"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_margin="2dp"
                android:text="JOG STOP"
                android:textSize="16sp" />

            <Button
                android:id="@+id/referenceAllJointsButton"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_margin="2dp"
                android:text="REFERENCE ALL JOINTS"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- EXPERT LOG -->
        <LinearLayout
            android:id="@+id/expertLogLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/logTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LOG"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="12dp" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#EEEEEE"
                android:padding="8dp"
                android:textSize="12sp"
                android:scrollbars="vertical"
                android:overScrollMode="always" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

